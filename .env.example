# 环境变量示例文件
#
# 用法：
#   1. 复制这个文件为 .env
#   2. 把下面的占位值换成你的真实密钥
#   3. 绝对不要把 .env 提交到版本库（.gitignore 已排除）
#
# 本地运行时，推荐直接用系统环境变量而不是 .env 文件：
#   PowerShell:
#     [Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY","sk-xxx","User")
#   设置后必须重开终端才生效。

# ---------- 大模型平台密钥（必填）----------
DEEPSEEK_API_KEY=sk-在这里填入你的真实密钥

# ---------- 向量模型下载镜像（国内必填）----------
# HuggingFace 主站在国内无法直连，必须走镜像
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存目录（可选，避免占用系统盘）
HF_HOME=E:\hf_home
